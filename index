let rCh=null;
function calcReplen(){
  const d=+document.getElementById('rDemand').value||1;
  const s=+document.getElementById('rStd').value||0;
  const l=+document.getElementById('rLead').value||1;
  const r=+document.getElementById('rReview').value||1;
  const z=+document.getElementById('rService').value;
  const c=+document.getElementById('rCost').value||1;
  const ss=Math.round(z*s*Math.sqrt(l+r));
  const mn=Math.round(d*l+ss);
  const mx=Math.round(d*(l+r)+ss);
  const oq=mx-mn;
  document.getElementById('replenOut').innerHTML=`
    <div class="rst-label">Safety stock</div><div class="rst-val">${ss.toLocaleString()} units</div>
    <div class="rst-label">Reorder point (MIN)</div><div class="rst-val">${mn.toLocaleString()} units</div>
    <div class="rst-label">Max level</div><div class="rst-val">${mx.toLocaleString()} units</div>
    <div class="rst-label">Replen qty</div><div class="rst-val ok">${oq.toLocaleString()} units</div>
  `;
  const days=Array.from({length:90},(_,i)=>'D'+(i+1));
  let inv=mx; const il=[],minL=[],maxL=[];
  for(let i=0;i<90;i++){
    const dem=Math.max(0,Math.round(d+(Math.random()-.5)*2*s));
    inv-=dem;
    if(inv<=mn) inv+=oq;
    il.push(inv); minL.push(mn); maxL.push(mx);
  }
  if(rCh) rCh.destroy();
  rCh=new Chart(document.getElementById('replenChart'),{
    type:'line',
    data:{labels:days,datasets:[
      {label:'Inventory level',data:il,borderColor:'#4a9eff',backgroundColor:'rgba(74,158,255,0.06)',fill:true,tension:0.3,pointRadius:0},
      {label:'MIN (reorder pt)',data:minL,borderColor:'#f5a623',borderDash:[4,3],pointRadius:0,borderWidth:1.5},
      {label:'MAX',data:maxL,borderColor:'rgba(52,209,122,.5)',borderDash:[4,3],pointRadius:0,borderWidth:1.5}
    ]},
    options:{plugins:{legend:{labels:{color:'#8a92a6',font:{size:10}}}},scales:{x:{ticks:{color:'#545c6e',maxTicksLimit:10},grid:{color:'rgba(255,255,255,0.04)'}},y:{ticks:{color:'#545c6e'},grid:{color:'rgba(255,255,255,0.04)'}}}}
  });
}

let pCh=null,pieCh=null;
function drawPareto(){
  const view=document.getElementById('pView').value;
  const loc=document.getElementById('pLoc').value;
  const sk=['SKU-001','SKU-002','SKU-003','SKU-004','SKU-005','SKU-006','SKU-007','SKU-008','SKU-009','SKU-010','SKU-011','SKU-012','SKU-013','SKU-014','SKU-015'];
  const seed=view.includes('Revenue')?1:view.includes('Order')?2:3;
  const vals=[38,18,11,7,5,4,3.5,3,2.5,2,1.5,1.2,1,.9,.9].map((v,i)=>+(v*(1+(seed-2)*.1+(loc.includes('HVAC')?.05*i:loc.includes('Parts')?-.03*i:0))).toFixed(1));
  const total=vals.reduce((a,b)=>a+b,0);
  let cum=0;
  const cp=vals.map(v=>{cum+=v;return Math.round((cum/total)*100);});
  const bc=cp.map(c=>c<=70?'#f5a623':c<=90?'#4a9eff':'#1a1e26');
  const bbc=cp.map(c=>c<=70?'rgba(245,166,35,.6)':c<=90?'rgba(74,158,255,.6)':'rgba(255,255,255,.15)');
  if(pCh) pCh.destroy();
  pCh=new Chart(document.getElementById('paretoChart'),{
    data:{labels:sk,datasets:[
      {type:'bar',label:view,data:vals,backgroundColor:bc,borderColor:bbc,borderWidth:1,borderRadius:3,yAxisID:'y'},
      {type:'line',label:'Cumulative %',data:cp,borderColor:'#34d17a',pointRadius:3,pointBackgroundColor:'#34d17a',tension:0,yAxisID:'y1'}
    ]},
    options:{plugins:{legend:{labels:{color:'#8a92a6',font:{size:10}}}},scales:{x:{ticks:{color:'#545c6e',font:{size:9}},grid:{color:'rgba(255,255,255,0.04)'}},y:{ticks:{color:'#545c6e'},grid:{color:'rgba(255,255,255,0.04)'}},y1:{position:'right',min:0,max:100,ticks:{color:'#545c6e',callback:v=>v+'%'},grid:{display:false}}}}
  });
  const aC=cp.filter(c=>c<=70).length, bC=cp.filter(c=>c>70&&c<=90).length, cC=cp.filter(c=>c>90).length;
  if(pieCh) pieCh.destroy();
  pieCh=new Chart(document.getElementById('abcPieChart'),{
    type:'doughnut',
    data:{labels:['A items (top 70%)','B items (70-90%)','C items (90-100%)'],datasets:[{data:[aC,bC,cC],backgroundColor:['#f5a623','#4a9eff','#1a1e26'],borderColor:['rgba(245,166,35,.4)','rgba(74,158,255,.4)','rgba(255,255,255,.1)'],borderWidth:1}]},
    options:{plugins:{legend:{position:'bottom',labels:{color:'#8a92a6',font:{size:10},padding:12}}}}
  });
  document.getElementById('paretoInsight').innerHTML=`<strong>Analysis:</strong> ${aC} SKUs (${Math.round(aC/sk.length*100)}% of items) drive 70% of ${view.toLowerCase()}. These A items deserve primary pick locations, tighter cycle count frequency, and min/max rules tuned to a 98%+ service level. The ${cC} C items represent roughly 10% of value and are candidates for bin consolidation or reduced replenishment priority.`;
}

let fCh=null;
function drawFc(){
  const sku=document.getElementById('fcSku').value;
  const meth=document.getElementById('fcMethod').value;
  const s=sku.includes('1042')?1:sku.includes('2081')?2:3;
  const seas=s===2?[.8,.85,1.0,1.2,1.3,1.1,.9,1.4,1.2,.9,.8,1.1]:s===1?[1.1,1.0,.9,.95,1.0,1.15,1.2,1.15,1.0,.95,1.1,1.2]:[1.0,.95,1.0,1.05,1.1,1.1,1.05,1.0,.95,.9,1.05,1.1];
  const base=[210,195,220,240,250,230,260,280,290,275,300,310,305,320,335,350,345,360];
  const hist=base.map((v,i)=>Math.round(v*seas[i%12]*(1+(s-2)*.08)+Math.sin(i*1.3+s)*14));
  const hl=14; const train=hist.slice(0,hl); let fc=[];
  if(meth.includes('3-month')){ for(let i=hl;i<hist.length+3;i++){const p=[...train,...fc].slice(-3);fc.push(Math.round(p.reduce((a,b)=>a+b)/3));} }
  else if(meth.includes('Exponential')){ let sv=train[0];const a=.35; for(let i=1;i<hl;i++) sv=a*train[i]+(1-a)*sv; for(let i=0;i<hist.length-hl+3;i++){sv=a*(hist[hl+i-1]||sv)+(1-a)*sv;fc.push(Math.round(sv));} }
  else{ const tr=(train[train.length-1]-train[0])/train.length; for(let i=0;i<hist.length-hl+3;i++) fc.push(Math.round(train[train.length-1]+tr*(i+1)*1.05*seas[(hl+i)%12])); }
  const labs=Array.from({length:hist.length+3},(_,i)=>{const m=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return m[(i+6)%12]+"'"+(String(23+Math.floor((i+6)/12)).slice(-2));});
  const errs=hist.slice(hl).map((v,i)=>Math.abs(v-fc[i]));
  const mae=errs.length?Math.round(errs.reduce((a,b)=>a+b)/errs.length):0;
  const mape=errs.length?(errs.map((e,i)=>e/hist[hl+i]).reduce((a,b)=>a+b)/errs.length*100).toFixed(1):0;
  const bias=errs.length?Math.round(fc.slice(0,errs.length).reduce((a,b)=>a+b)/errs.length-hist.slice(hl).reduce((a,b)=>a+b)/errs.length):0;
  document.getElementById('fcMae').textContent=mae+' units';
  document.getElementById('fcMape').textContent=mape+'%';
  document.getElementById('fcBias').textContent=(bias>=0?'+':'')+bias;
  document.getElementById('fcNext').textContent=fc[fc.length-1].toLocaleString();
  if(fCh) fCh.destroy();
  fCh=new Chart(document.getElementById('fcChart'),{
    type:'line',
    data:{labels:labs,datasets:[
      {label:'Actual demand',data:[...hist,null,null,null],borderColor:'#4a9eff',backgroundColor:'rgba(74,158,255,0.06)',fill:true,tension:.4,pointRadius:2},
      {label:'Forecast',data:[...Array(hl).fill(null),...fc],borderColor:'#f5a623',borderDash:[5,4],backgroundColor:'rgba(245,166,35,0.06)',fill:true,tension:.4,pointRadius:3}
    ]},
    options:{plugins:{legend:{labels:{color:'#8a92a6',font:{size:10}}}},scales:{x:{ticks:{color:'#545c6e',maxTicksLimit:10},grid:{color:'rgba(255,255,255,0.04)'}},y:{ticks:{color:'#545c6e'},grid:{color:'rgba(255,255,255,0.04)'}}}}
  });
}
<\/script>
</body>
</html>
